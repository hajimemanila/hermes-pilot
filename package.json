{
  "name": "hermes-pilot",
  "version": "0.2.0",
  "description": "Drive an autonomous Hermes Agent from your phone or tablet: Quick Review, annotation, kanban and chat in one installable PWA.",
  "license": "MIT",
  "homepage": "https://github.com/hajimemanila/hermes-pilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hajimemanila/hermes-pilot.git"
  },
  "type": "module",
  "bin": {
    "hermes-pilot": "bin/hermes-pilot.mjs"
  },
  "files": [
    "bin/",
    "__init__.py",
    "dashboard/",
    "apps/bridge/src/",
    "apps/web/dist/",
    "apps/dashboard/*.py",
    "apps/dashboard/*.js",
    "apps/dashboard/*.css",
    "apps/dashboard/*.json",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "skills/quick-review/",
    "skills/annotation/",
    "skills/spec-architect/",
    "scripts/postinstall.mjs",
    "scripts/deploy.mjs",
    "scripts/migrate-to-hermes-pilot.mjs",
    "scripts/sync-dashboard.mjs",
    "plugin.json",
    "plugin.yaml",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "probe": "node scripts/probe-ws.mjs",
    "bridge": "node apps/bridge/src/server.js",
    "dev": "vite --config apps/web/vite.config.js",
    "build": "vite build --config apps/web/vite.config.js",
    "build:demo": "VITE_DEMO_MODE=1 vite build --config apps/web/vite.config.js --outDir dist-demo --base ./ && node scripts/build-demo-embed.mjs",
    "test": "node --test apps/bridge/test/*.test.js apps/web/test/*.test.js",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node apps/bridge/src/server.js",
    "probe:bridge": "node scripts/probe-bridge.mjs",
    "revoke": "node scripts/revoke.mjs",
    "check:pwa": "python3 scripts/check-pwa.py --dir apps/web/public",
    "check:oauth": "node scripts/check-oauth-boundary.mjs",
    "check:dashboard": "node scripts/sync-dashboard.mjs --check",
    "sync:dashboard": "node scripts/sync-dashboard.mjs",
    "check:pwa:live": "python3 scripts/check-pwa.py --url http://127.0.0.1:4097",
    "check:pwa:selftest": "python3 scripts/check-pwa.py --self-test",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "verify": "npm test && npm run check:dashboard && npm run check:pwa && npm run check:oauth && npm run build && npm run audit:responsive",
    "deploy": "node scripts/deploy.mjs",
    "migrate:pilot": "node scripts/migrate-to-hermes-pilot.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  }
}
