{
  "id": "/",
  "name": "Hermes Pilot",
  "short_name": "Hermes Pilot",
  "description": "Watch, stop and talk to Hermes Agent from anywhere (separate-origin PWA)",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#06161a",
  "theme_color": "#06161a",
  "lang": "en",
  "icons": [
    {
      "src": "/icon-192-v6.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-v6.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192-v6.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512-v6.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-v6.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
