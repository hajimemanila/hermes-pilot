{
  "id": "/hermes-mobile",
  "name": "Hermes Mobile",
  "short_name": "Hermes",
  "description": "Hermes Agent を外出先から見る・止める・話す（別オリジン PWA）",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06161a",
  "theme_color": "#06161a",
  "lang": "ja",
  "icons": [
    {
      "src": "/icon-192-v4.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192-v4.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
